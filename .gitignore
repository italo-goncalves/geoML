# Compiled python modules.
*.pyc

# Setuptools distribution folder.
/dist/

# Python egg metadata, regenerated from source files by setuptools.
/*.egg-info
/*.egg

# JetBrains per-user workspace state (not shared), one file per machine.
.idea/workspace*.xml

# Written by the IDE itself; the rest of .idea/ is shared and tracked.
.idea/.gitignore

# VS Code launch/debug settings, per machine.
.vscode/

# The built documentation site: CI builds it, and publishes it on a tag.
/docs/build/

# The manual, copied in from `docs/manual/` when the site builds so that its
# figures resolve. One copy in git; this one is made and remade.
/docs/source/manual/
